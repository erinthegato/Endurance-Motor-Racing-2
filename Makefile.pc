# PC test build (software renderer): make -f Makefile.pc && ./emr_test race ardennes 1 1 11 shots 30
SRC = src/data.cpp src/track.cpp src/race.cpp src/racecontrol.cpp src/launch.cpp src/reliability.cpp src/champ.cpp src/career.cpp src/settings.cpp src/menu.cpp src/sound.cpp src/render.cpp src/render_fx.cpp src/clip.cpp src/game.cpp src/intro.cpp src/trophies.cpp src/setups.cpp src/setupeng.cpp src/walk.cpp src/platform_pc.cpp tests/pc_main.cpp
emr_test: $(SRC) src/*.h
	$(CXX) -O2 -std=c++17 -Wall -o $@ $(SRC) -lz
asan: $(SRC) src/*.h
	$(CXX) -O1 -g -std=c++17 -fsanitize=address,undefined -o emr_test_asan $(SRC) -lz
clean:
	rm -f emr_test emr_test_asan
